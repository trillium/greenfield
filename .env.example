# Ports for this project. Copy to .env (gitignored) and change them if they collide on your machine:
#   cp .env.example .env
# The Mac daemon (mac/) reads .env itself, and its Makefile and scripts source scripts/load-env.sh.
# A value passed on the command line (--port) or already exported in the shell wins over .env.

# greenfield-inserter: the HTTP port the Mac daemon listens on (tailnet address and loopback).
GREENFIELD_PORT=47821

# Trainer client (not on every branch yet): the port the trainer talks to.
GREENFIELD_TRAINER_PORT=8750
