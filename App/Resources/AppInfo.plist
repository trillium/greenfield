<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GreenfieldPresetComputers</key>
	<string>$(GREENFIELD_PRESET_COMPUTERS)</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_greenfield._tcp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>greenfield-add-computer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>greenfield</string>
			</array>
		</dict>
	</array>
	<key>GreenfieldMinPeerVersion</key>
	<string>$(GREENFIELD_MIN_PEER_VERSION)</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera is only used to scan the code that adds a computer. Nothing is recorded or saved.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The microphone is used to turn what you say into text. Audio is transcribed on this phone and never leaves it; only the resulting text is sent, to the Mac you choose.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Used to send the text you dictate to a Mac on your network.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
