# Generated by XcodeGen -- project.yml is the source of truth
*.xcodeproj
*.xcworkspace

# Build output
build/
DerivedData/
.build/
*.swp
*.xcarchive
*.ipa
*.dSYM.zip

# macOS / Xcode
.DS_Store
xcuserdata/
*.xcuserstate

# Staged by `make core`: detector libraries and the personal model
.parrot-core/

# Machine-local overrides
Config/Local.xcconfig
# Generated from git tags by scripts/version.sh
Config/Version.xcconfig
# Generated from the kit checkout by scripts/kit-version.sh
Config/Kit.xcconfig
.claude/settings.local.json

# Speech models and audio are never committed: weights are downloaded at runtime (docs/attribution.md)
*.mlmodelc
*.mlpackage
*.gguf
*.wav
*.m4a
*.caf
*.pcm

# Never commit signing material or credentials (enforced by scripts/check-secrets.sh)
*.p8
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
*.certSigningRequest
*.keychain
*.keychain-db
AuthKey_*
.env
.env.*
!.env.example

# Generated from git tags by mac/Makefile
mac/Sources/InserterCore/GeneratedVersion.swift

__pycache__/
*.pyc

# Agent tool scratch output (never source)
.pi/
